[Unit]
Description=One-Camera Jetson Robot
After=multi-user.target nvargus-daemon.service
Wants=nvargus-daemon.service

[Service]
Type=simple
User=@USER@
Group=@USER@
SupplementaryGroups=dialout video
WorkingDirectory=@PROJECT_DIR@
Environment=PYTHONUNBUFFERED=1
Environment=ROBOT_HEADLESS=1
ExecStart=@PROJECT_DIR@/.venv/bin/python -m app.robot_runner --headless
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
